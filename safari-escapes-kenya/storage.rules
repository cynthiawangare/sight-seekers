rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Package images — admin can write, anyone can read
    match /packages/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // User avatars — owner can write, anyone can read
    match /avatars/{userId}/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId;
    }

    // General uploads
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
